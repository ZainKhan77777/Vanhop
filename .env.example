# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vanhop?retryWrites=true&w=majority

# Secret used to sign the admin session JWT. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@vanhop.ge
ADMIN_PASSWORD=vanhop123

# Public base URL of the app. Used for the phone-key link in the booking email.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) -------------------------------------------------------
# Sends the booking confirmation carrying the reference. Leave these blank and
# the app still books normally; the email is printed to the server log instead.
#
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
MAIL_FROM=VanHop <you@gmail.com>
