# MongoDB Atlas connection string. URL-encode special characters in the password.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/vanhop?retryWrites=true&w=majority

# Secret used to sign the admin session JWT. Generate with: openssl rand -base64 32
JWT_SECRET=replace-me-with-a-long-random-string

# Admin account created by `npm run seed`
ADMIN_EMAIL=admin@vanhop.ge
ADMIN_PASSWORD=vanhop123

# Public base URL of the app
NEXT_PUBLIC_APP_URL=http://localhost:3000
